#!/bin/bash
# Submitted at: $(date +%Y-%m-%d\ %H:%M:%S)
#SBATCH --chdir /home/jsyu/ManipTrans
#SBATCH --nodes 1
#SBATCH --cpus-per-task 8
#SBATCH --ntasks 1
#SBATCH --mem 40G
#SBATCH --gres=gpu:1
#SBATCH --qos=normal
#SBATCH --output=logs/inspire/slurm_%j/slurm-%j.out
#SBATCH --error=logs/inspire/slurm_%j/slurm-%j.err
#SBATCH --mail-user=jeffrey.yu@epfl.ch
#SBATCH --mail-type=END,FAIL
#SBATCH --time 04:00:00

# Grip-force logging for one model across a fold's 10 held-out demos.
# Arguments are forwarded to eval_grip_kfold.sh (fold, then optionally a checkpoint):
#     sbatch slurm/scitas/eval_grip_kfold.run          # F0, default checkpoint
#     sbatch slurm/scitas/eval_grip_kfold.run F2 runs/.../nn/some.pth

echo "Starting grip-force sweep on $HOSTNAME at $(date)"
source /home/jsyu/miniconda/etc/profile.d/conda.sh
conda activate maniptrans

bash eval_grip_kfold.sh "$@"
