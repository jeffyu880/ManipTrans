#!/bin/bash
# Submitted at: $(date +%Y-%m-%d\ %H:%M:%S)
#SBATCH --chdir /home/jsyu/ManipTrans
#SBATCH --nodes 1
#SBATCH --cpus-per-task 8
#SBATCH --ntasks 1
#SBATCH --mem 40G
#SBATCH --gres=gpu:1
#SBATCH --qos=normal
#SBATCH --array=0-3
#SBATCH --output=logs/inspire/slurm_%j/slurm-%j.out
#SBATCH --error=logs/inspire/slurm_%j/slurm-%j.err
#SBATCH --mail-user=jeffrey.yu@epfl.ch
#SBATCH --mail-type=END,FAIL
#SBATCH --time 72:00:00

# Four multi-demo trainings over the reach recordings (slurm/scitas/reach_demo.csv),
# one per array task. Demos are taken in CSV order within each distance group.
#
#   0: dist_1-2   2 demos from each of distances 1,2      (4 demos)
#   1: dist_3-4   2 demos from each of distances 3,4      (4 demos)
#   2: dist_4-5   2 demos from each of distances 4,5      (4 demos)
#   3: dist_1-5   2 demos from each of distances 1..5     (10 demos)

echo "Starting ManipTrans reach-distance training on $HOSTNAME at $(date)"
source /home/jsyu/miniconda/etc/profile.d/conda.sh
conda activate maniptrans

NAMES=(
    "dist_1-2"
    "dist_3-4"
    "dist_4-5"
    "dist_1-5"
)

CONFIGS=(
    "m_130824,m_130919,m_131600,m_131647"
    "m_131108,m_131154,m_131404,m_131434"
    "m_131404,m_131434,m_131227,m_131256"
    "m_130824,m_130919,m_131600,m_131647,m_131108,m_131154,m_131404,m_131434,m_131227,m_131256"
)

DATA_INDICES="${CONFIGS[$SLURM_ARRAY_TASK_ID]}"
EXPERIMENT_NAME="reach_${NAMES[$SLURM_ARRAY_TASK_ID]}_AUG_noise"
echo "Array task ${SLURM_ARRAY_TASK_ID} -> experiment ${EXPERIMENT_NAME}, indices ${DATA_INDICES}"

# Stagger launches by 5s per array index so concurrent tasks don't start in lockstep
# (avoids simultaneous dataset load / GPU alloc / wandb init contention).
STAGGER=$((SLURM_ARRAY_TASK_ID * 5))
echo "Sleeping ${STAGGER}s before launch (stagger by array index)"
sleep ${STAGGER}

python main/rl/train.py \
    task=ResDexHand \
    dexhand=inspire \
    side=BiH \
    headless=true \
    num_envs=8192 \
    learning_rate=2e-4 \
    test=false \
    randomStateInit=true \
    "dataIndices=[${DATA_INDICES}]" \
    rh_base_model_checkpoint=assets/imitator_rh_inspire.pth \
    lh_base_model_checkpoint=assets/imitator_lh_inspire.pth \
    early_stop_epochs=1000 \
    actionsMovingAverage=0.6 \
    max_iterations=10000 \
    wandb_activate=True \
    wandb_entity=jeffreyyu880-epfl \
    wandb_project=ManipTrans \
    useCoaxialReward=false \
    useTrajAug=true \
    RH_LH_Table_Center_Aug=true \
    RH_LObj_Center_Aug=true \
    RH_RObj_Center_Aug=true \
    LH_LObj_Center_Aug=true \
    causal=true \
    jointNoiseCm=0.5 \
    failureThresholdNoiseCompensation=1.5 \
    numTrajAug=400 \
    "experiment='${EXPERIMENT_NAME}'"
