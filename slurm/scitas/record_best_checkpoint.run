#!/bin/bash
# Submitted at: $(date +%Y-%m-%d\ %H:%M:%S)
#SBATCH --chdir /home/jsyu/ManipTrans
#SBATCH --nodes 1
#SBATCH --cpus-per-task 8
#SBATCH --ntasks 1
#SBATCH --mem 40G
#SBATCH --gres=gpu:1
#SBATCH --qos=normal
#SBATCH --output=logs/inspire/slurm_%j/slurm-%j.out
#SBATCH --error=logs/inspire/slurm_%j/slurm-%j.err
#SBATCH --mail-user=jeffrey.yu@epfl.ch
#SBATCH --mail-type=END,FAIL
#SBATCH --time 6:00:00

echo "Starting record_best_checkpoint on $HOSTNAME at $(date)"
source /home/jsyu/miniconda/etc/profile.d/conda.sh
conda activate maniptrans

# Per-index: for each m_<id>, find the highest-reward checkpoint across its
# runs/capping_md_m_<id>__*/nn/ folders and record it on dataIndices=[m_<id>].
# Paths are relative to the repo root, guaranteed by the absolute --chdir above.
bash record_best_checkpoint.sh \
    m_133607 m_133622 m_133637 m_133711 m_133727 \
    m_133842 m_153706 m_153723 m_153738 m_153753 \
    m_133903 m_133917 m_133931 m_134000 m_153810
