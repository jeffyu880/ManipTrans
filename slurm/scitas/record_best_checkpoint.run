#!/bin/bash
# Submitted at: $(date +%Y-%m-%d\ %H:%M:%S)
# Replay a trained policy in test mode and record videos of the rollouts.
# Edit the invocation at the bottom, then:  sbatch slurm/scitas/record_best_checkpoint.run
#SBATCH --chdir /home/jsyu/ManipTrans
#SBATCH --nodes 1
#SBATCH --cpus-per-task 8
#SBATCH --ntasks 1
#SBATCH --mem 40G
#SBATCH --gres=gpu:1
#SBATCH --qos=normal
#SBATCH --output=logs/inspire/slurm_%j/slurm-%j.out
#SBATCH --error=logs/inspire/slurm_%j/slurm-%j.err
#SBATCH --mail-user=jeffrey.yu@epfl.ch
#SBATCH --mail-type=END,FAIL
#SBATCH --time 6:00:00

echo "Starting record_best_checkpoint on $HOSTNAME at $(date)"
source /home/jsyu/miniconda/etc/profile.d/conda.sh
conda activate maniptrans

# Replays the highest _rew_ checkpoint with test=true, randomStateInit=false, 20 rollouts ->
# runs/<run>/videos/<m_id>/epoch_<N>/*.mp4.  Two modes:
#   --run <folder>   any run; takes dataIndices from its own config.yaml. Accepts several folders.
#   m_<id> ...       ONLY runs named capping_md_m_<id>__*; silently skips anything else.
# Flags: --list (dry run) | --checkpoint <pth> | --indices m_a m_b | --combined
bash record_best_checkpoint.sh \
    --run m_191211 \
    --list 

# Old capping indices (mode 2):
# bash record_best_checkpoint.sh \
#     m_133607 m_133622 m_133637 m_133711 m_133727 \
#     m_133842 m_153706 m_153723 m_153738 m_153753 \
#     m_133903 m_133917 m_133931 m_134000 m_153810
