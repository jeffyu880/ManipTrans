#!/bin/bash
# Submitted at: $(date +%Y-%m-%d\ %H:%M:%S)
#SBATCH --chdir /home/jsyu/ManipTrans
#SBATCH --nodes 1
#SBATCH --cpus-per-task 8
#SBATCH --ntasks 1
#SBATCH --mem 40G
#SBATCH --gres=gpu:1
#SBATCH --qos=normal
#SBATCH --array=0-4
#SBATCH --output=logs/inspire/slurm_%j/slurm-%j.out
#SBATCH --error=logs/inspire/slurm_%j/slurm-%j.err
#SBATCH --mail-user=jeffrey.yu@epfl.ch
#SBATCH --mail-type=END,FAIL
#SBATCH --time 8:00:00

# 5-fold leave-one-fold-out cross-validation over the reach demos (data_stats/reach_demo.csv).
# 50 demos are split into 5 folds of 10 (2 per distance per fold); array task k HOLDS OUT fold k
# and trains ONE residual policy on the other 4 folds (40 demos). The held-out fold is validated
# separately by eval_kfold.sh. The split is produced by data_stats/make_kfold.py (seed=0) -- the
# SAME generator the eval side uses, so training and validation can never disagree on the split.
#
#   task k -> train on folds != k (40 demos) -> runs/reach_5foldcv_holdout<k>_seed0__<date>/
#
# Add %N to the --array line (e.g. 0-4%3) to cap concurrent tasks if GPUs are scarce.

echo "Starting ManipTrans 5-fold CV training on $HOSTNAME at $(date)"
source /home/jsyu/miniconda/etc/profile.d/conda.sh
conda activate maniptrans

K=$SLURM_ARRAY_TASK_ID
# 40 training demos = union of all folds except k; 10 held-out = fold k (echoed for the record).
DATA_INDICES=$(python data_stats/make_kfold.py --fold "$K" --which train)
HELDOUT=$(python data_stats/make_kfold.py --fold "$K" --which heldout)
EXPERIMENT_NAME="reach_5foldcv_holdout${K}_seed0"

echo "Array task ${K} -> experiment ${EXPERIMENT_NAME}"
echo "  held-out fold ${K} (validation, NOT trained): ${HELDOUT}"
echo "  training on 40 demos: ${DATA_INDICES}"

# Stagger launches by 5s per array index so concurrent tasks don't start in lockstep
# (avoids simultaneous dataset load / GPU alloc / wandb init contention).
STAGGER=$((SLURM_ARRAY_TASK_ID * 5))
echo "Sleeping ${STAGGER}s before launch (stagger by array index)"
sleep ${STAGGER}

# Multi-demo training params mirror slurm/scitas/train_reach_dist_array.run, plus maxDemoLength=252
# to balance sampling across the 40 demos of differing length (the env round-robins demos over envs).
python main/rl/train.py \
    task=ResDexHand \
    dexhand=inspire \
    side=BiH \
    headless=true \
    num_envs=8192 \
    learning_rate=2e-4 \
    test=false \
    randomStateInit=true \
    "dataIndices=[${DATA_INDICES}]" \
    rh_base_model_checkpoint=assets/imitator_rh_inspire.pth \
    lh_base_model_checkpoint=assets/imitator_lh_inspire.pth \
    early_stop_epochs=1000 \
    actionsMovingAverage=0.6 \
    max_iterations=10000 \
    wandb_activate=True \
    wandb_entity=jeffreyyu880-epfl \
    wandb_project=ManipTrans \
    useCoaxialReward=false \
    useTrajAug=false \
    RH_LH_Table_Center_Aug=true \
    RH_LObj_Center_Aug=true \
    RH_RObj_Center_Aug=true \
    LH_LObj_Center_Aug=true \
    causal=true \
    jointNoiseCm=0.0 \
    failureThresholdNoiseCompensation=1.5 \
    numTrajAug=10 \
    "experiment='${EXPERIMENT_NAME}'"
