#!/bin/bash
# Stage-2 residual training on the cup + brush capture, ONE DEMO PER ARRAY TASK.
# Single-demo counterpart to train_cup_brush_inspire.run (which trains on both at once); every
# other flag is identical, so the three runs differ only in dataIndices.
#SBATCH --chdir /home/jsyu/ManipTrans
#SBATCH --nodes 1
#SBATCH --cpus-per-task 8
#SBATCH --ntasks 1
#SBATCH --mem 40G
#SBATCH --gres=gpu:1
#SBATCH --qos=normal
#SBATCH --array=0-1
#SBATCH --output=logs/inspire/slurm_%j/slurm-%j.out
#SBATCH --error=logs/inspire/slurm_%j/slurm-%j.err
#SBATCH --mail-user=jeffrey.yu@epfl.ch
#SBATCH --mail-type=END,FAIL
#SBATCH --time 10:00:00

#   0: m_191123   brush_cap_0802_m_191123.pkl   367 frames @ 60 fps
#   1: m_191211   brush_cap_0802_m_191211.pkl   383 frames @ 60 fps

echo "Starting ManipTrans cup_brush single-demo training on $HOSTNAME at $(date)"
source /home/jsyu/miniconda/etc/profile.d/conda.sh
conda activate maniptrans

CONFIGS=(
    "m_191123"
    "m_191211"
)

DATA_INDICES="${CONFIGS[$SLURM_ARRAY_TASK_ID]}"
EXPERIMENT_NAME="cup_brush_${DATA_INDICES}"
echo "Array task ${SLURM_ARRAY_TASK_ID} -> experiment ${EXPERIMENT_NAME}, indices ${DATA_INDICES}"

# Stagger launches by 5s per array index so concurrent tasks don't start in lockstep
# (avoids simultaneous dataset load / GPU alloc / wandb init contention).
STAGGER=$((SLURM_ARRAY_TASK_ID * 5))
echo "Sleeping ${STAGGER}s before launch (stagger by array index)"
sleep ${STAGGER}

python main/rl/train.py \
    task=ResDexHand \
    dexhand=inspire \
    side=BiH \
    headless=true \
    num_envs=8192 \
    learning_rate=2e-4 \
    test=false \
    randomStateInit=true \
    "dataIndices=[${DATA_INDICES}]" \
    rh_base_model_checkpoint=assets/imitator_rh_inspire.pth \
    lh_base_model_checkpoint=assets/imitator_lh_inspire.pth \
    early_stop_epochs=1000 \
    actionsMovingAverage=0.6 \
    max_iterations=10000 \
    wandb_activate=True \
    wandb_entity=jeffreyyu880-epfl \
    wandb_project=ManipTrans \
    sharedObject=true \
    useCoaxialReward=false \
    useTrajAug=false \
    RH_LH_Table_Center_Aug=true \
    RH_LObj_Center_Aug=false \
    RH_RObj_Center_Aug=false \
    LH_LObj_Center_Aug=false \
    causal=true \
    jointNoiseCm=0.0 \
    failureThresholdNoiseCompensation=1.5 \
    numTrajAug=100 \
    "experiment='${EXPERIMENT_NAME}'"

# [CUP_BRUSH] sharedObject=true is REQUIRED here and is purely a REWARD toggle: both hands score
# the same body (the brush), so without it the brush's object terms are paid twice — once per hand —
# doubling their weight against the hand-tracking terms. Spawning one scored actor instead of two is
# inferred from the demo itself, not from this flag.
#
# useTrajAug=false, so numTrajAug and the four *_Aug flags below it are inert (num_aug collapses to
# 1 and the aug loop never runs); they are kept so this script stays diff-able against
# train_cup_brush_inspire.run. jointNoiseCm is applied inside that same loop, so it is inert too.
#
# objectSet=cup_brush is deliberately NOT passed: it is a LIVE-only knob. Offline the loaders infer
# the set from the objects the capture recorded.

# --- Recording evaluation: replay the trained policy and capture rollout videos ---
# record_best_checkpoint.sh --run <dir> finds the highest _rew_ checkpoint under <dir>/nn/,
# reads dataIndices from <dir>/config.yaml, and evaluates it (test=true, capture_video=true) ->
#   runs/<dir>/videos/<m_id>/epoch_<N>/*.mp4
# Array job: each task's experiment is EXPERIMENT_NAME (cup_brush_<idx>), so match that run dir.
RUN_DIR=$(ls -dt runs/${EXPERIMENT_NAME}__* 2>/dev/null | head -1)
if [[ -n "$RUN_DIR" ]]; then
    echo "=== Recording eval rollouts from $RUN_DIR on $HOSTNAME at $(date) ==="
    bash record_best_checkpoint.sh --run "$RUN_DIR"
else
    echo "[WARN] no run dir matching runs/${EXPERIMENT_NAME}__* found; skipping eval recording"
fi
