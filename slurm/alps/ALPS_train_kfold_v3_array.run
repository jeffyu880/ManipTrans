#!/bin/bash
# Submitted at: $(date +%Y-%m-%d\ %H:%M:%S)
#SBATCH --chdir /users/jsyu/ManipTrans
#SBATCH --nodes 1
#SBATCH --cpus-per-task 8
#SBATCH --ntasks 1
#SBATCH --mem 40G
#SBATCH --gres=gpu:1
#SBATCH --qos=normal
#SBATCH --array=0-4
#SBATCH --output=logs/inspire/slurm_%j/slurm-%j.out
#SBATCH --error=logs/inspire/slurm_%j/slurm-%j.err
#SBATCH --mail-user=jeffrey.yu@epfl.ch
#SBATCH --mail-type=END,FAIL
#SBATCH --time 6:00:00

# Full 5-fold CV over the reach pool with a SAMPLED imitator (deterministicBaseAction=false, the
# config default) and TRAIN-time trajectory augmentation (useTrajAug=true, numTrajAug=10,
# jointNoiseCm=0.3). Array task k holds out fold k, trains one residual on the other 4 folds, then
# scores that residual on fold k -- the fold it did not train on.
#   task k -> runs/reach_5foldcv_v3_holdout<k>_seed0_AUG__<date>/ + dumps/v3aug_fold<k>/
#
# The non-augmented counterpart lives in the git history of this file (job 77235: EXPERIMENT_NAME
# without the _AUG suffix, useTrajAug=false, jointNoiseCm=0.0, failureThresholdNoiseCompensation
# unchanged at 1.5). Its already-trained checkpoints are scored by ALPS_eval_kfold_sampled.run.
#
# Train and eval are chained in ONE array task rather than split into a follow-up job: task k
# already owns fold k's checkpoint and fold k is by construction its held-out set, so no scheduling
# or checkpoint-resolution round trip is needed. This does not contradict the "evaluation is a
# single job, never a per-run array" rule -- no separate eval array is created.
#
# deterministicBaseAction=false, unlike slurm/alps/ALPS_train_kfold_v2_det_array.run: that ablation
# (docs/deterministic_base_ablation.md) found freezing the base to mu during training costs ~0.32
# held-out success, so sampled is the setting to go back to.
#
# Why v3 and not v2: data_stats/reach_demo_v3.csv was re-edited on 2026-08-04 (m_101613/m_101752/
# m_101901/m_101919/m_102009 added; m_140827/m_141150/m_141254/m_133637/m_133727 removed), so the
# fold membership no longer matches the 07-29 reach_5foldcv_v2_holdout* runs. A distinct prefix
# keeps kfold_confusion_matrix.py --run-prefix from globbing the two incompatible pools together.
# The CSV keeps its _v2 filename; only the run prefix is versioned.
#
# PREREQS: retargeted pkls for every demo in the pool (data/retargeting/my_dataset/mano2inspire_{rh,lh}/).
# Verified present for all 51 pool demos on 2026-08-04.
#
# Submit:  sbatch --account=abs18 slurm/alps/ALPS_train_kfold_v3_array.run
# Add %N to --array (e.g. 0-4%3) to cap concurrent tasks if GPUs are scarce.
#
# --time 6:00:00: jobs 77235/77240 trained all ten folds in 2:45:33-4:00:44 wall (every task
# early-stopped, none hit max_iterations), and the chained eval adds ~17 min for 10 demos --
# measured from ALPS_eval_kfold_detimit.run's 1:25:33 over 50. 4:01 + 0:17 leaves ~30% headroom.

echo "Starting 5-fold CV v3 sampled-imitator training on $HOSTNAME at $(date)"
source /users/jsyu/miniconda3/etc/profile.d/conda.sh
conda activate maniptrans

POOL_CSV="data_stats/reach_demo_v3.csv"
K=$SLURM_ARRAY_TASK_ID
# 40 training demos = union of all folds except k; held-out = fold k (echoed for the record).
DATA_INDICES=$(python data_stats/make_kfold.py --csv "$POOL_CSV" --fold "$K" --which train --seed 0)
HELDOUT=$(python data_stats/make_kfold.py --csv "$POOL_CSV" --fold "$K" --which heldout --seed 0)
EXPERIMENT_NAME="reach_5foldcv_v3_holdout${K}_seed0_AUG"

echo "Array task ${K} -> experiment ${EXPERIMENT_NAME}"
echo "  held-out fold ${K} (validation, NOT trained): ${HELDOUT}"
echo "  training on: ${DATA_INDICES}"

# The whole point of the CV is that the scored fold shares no demo with the 40 just trained on.
# make_kfold.py deals both lists from one split, so this can only fire if $POOL_CSV was edited
# between the two calls above -- which is exactly the failure the v2/v3 rename was meant to catch.
OVERLAP=""
for demo in ${HELDOUT//,/ }; do
    [[ ",${DATA_INDICES}," == *",${demo},"* ]] && OVERLAP+="${demo} "
done
if [[ -n "$OVERLAP" ]]; then
    echo "[ERROR] held-out demos also appear in the training set: ${OVERLAP}"
    echo "        ${POOL_CSV} must have changed between the two make_kfold.py calls above."
    echo "        Re-check the pool CSV, then resubmit; do not trust any score from this run."
    exit 1
fi

# Stagger launches by 5s per array index so concurrent tasks don't start in lockstep
# (avoids simultaneous dataset load / GPU alloc / wandb init contention).
STAGGER=$((SLURM_ARRAY_TASK_ID * 5))
echo "Sleeping ${STAGGER}s before launch (stagger by array index)"
sleep ${STAGGER}

python main/rl/train.py \
    task=ResDexHand \
    dexhand=inspire \
    side=BiH \
    headless=true \
    num_envs=8192 \
    learning_rate=2e-4 \
    test=false \
    randomStateInit=true \
    "dataIndices=[${DATA_INDICES}]" \
    rh_base_model_checkpoint=assets/imitator_rh_inspire.pth \
    lh_base_model_checkpoint=assets/imitator_lh_inspire.pth \
    early_stop_epochs=1000 \
    actionsMovingAverage=0.6 \
    max_iterations=10000 \
    wandb_activate=True \
    wandb_entity=jeffreyyu880-epfl \
    wandb_project=ManipTrans \
    useCoaxialReward=false \
    useTrajAug=true \
    RH_LH_Table_Center_Aug=true \
    RH_LObj_Center_Aug=true \
    RH_RObj_Center_Aug=true \
    LH_LObj_Center_Aug=true \
    causal=true \
    jointNoiseCm=0.3 \
    deterministicBaseAction=false \
    failureThresholdNoiseCompensation=1.5 \
    numTrajAug=10 \
    "experiment='${EXPERIMENT_NAME}'"

# ---------------------------------------------------------------------------
# Held-out validation of the residual just trained, on fold K's CLEAN demos.
#
# eval_kfold.sh re-derives the held-out set from the same make_kfold.py (--csv/--fold/--seed all
# match the training call above), so the two sides cannot disagree on the split. Its COMMON block
# pins every augmentation and noise source off, so augmentation stays a training-time treatment and
# is deliberately not reproduced at eval -- that is what makes this score comparable to the
# non-augmented family's.
#
# DET_BASE=false: the frozen imitators sample Normal(mu, sigma) at eval, as they did during v3
# training. This is the v3 eval arm, matching ALPS_eval_kfold_{sampled,detimit}.run -- keep all
# three in step or the v3 families stop being comparable. Note the v2 matrices in
# docs/deterministic_base_ablation.md were scored at DET_BASE=true to keep that ablation clean, so
# v3 numbers are not comparable to them on this axis either.
# ---------------------------------------------------------------------------
echo "######################################################################"
echo "# FOLD ${K} held-out validation at $(date)"
echo "######################################################################"

# IsaacGym's gym_38.so links libpython3.8.so.1.0 from the conda env's lib/; `conda activate` does
# not put it on LD_LIBRARY_PATH. Same block as ALPS_eval_kfold_sampled.run.
py_bin=$(command -v python) || { echo "[ERROR] python not found"; exit 1; }
py_lib="$(dirname "$(dirname "$(readlink -f "$py_bin")")")/lib"
[[ -e "$py_lib/libpython3.8.so.1.0" ]] && export LD_LIBRARY_PATH="$py_lib:${LD_LIBRARY_PATH:-}"

# eval_kfold.sh's glob interpolates to runs/<prefix><k>_seed0__<glob>, so no RUN_PREFIX can reach
# this family: the _AUG infix sits between _seed0 and __. Resolve the best checkpoint here and pass
# it via --checkpoint, the same way ALPS_eval_kfold_detimit.run does. Globbing THIS task's run dir
# also stops a rerun of fold K from scoring the older training left in a second timestamped dir.
RUN_DIR=$(ls -td runs/${EXPERIMENT_NAME}__* 2>/dev/null | head -1)
if [[ -z "$RUN_DIR" ]]; then
    echo "[ERROR] no run dir matched runs/${EXPERIMENT_NAME}__* -- training produced nothing to score."
    exit 1
fi

# Highest-reward checkpoint. `_rew_+` absorbs the doubled underscore base.py writes for early-stop
# saves, which a plain (?<=_rew_) lookbehind silently skips; \K keeps only the number.
BEST=""
BEST_REW=-9999999
shopt -s nullglob
for pth in "${RUN_DIR}"/nn/*.pth; do
    rew=$(basename "$pth" | grep -oP '_rew_+\K-?[0-9.]+' | head -1)
    [[ -z "$rew" ]] && continue
    if awk "BEGIN{exit !($rew > $BEST_REW)}"; then BEST_REW="$rew"; BEST="$pth"; fi
done
shopt -u nullglob
if [[ -z "$BEST" ]]; then
    echo "[ERROR] no reward-parseable checkpoint under ${RUN_DIR}/nn/ -- nothing to score."
    exit 1
fi
echo "  best checkpoint (rew ${BEST_REW}): ${BEST}"

# DUMP_TAG must not be v3_fold<k>: that belongs to the non-augmented family scored by
# ALPS_eval_kfold_sampled.run, and the two would overwrite each other during aggregation.
t0=$SECONDS
DET_BASE=false DUMP_TAG="v3aug_fold${K}" bash eval_kfold.sh --checkpoint "$BEST" "$K"
echo "=== fold ${K} eval finished in $((SECONDS - t0))s -> dumps/v3aug_fold${K}/ ==="

echo "Once all five tasks are done, build the matrix with:"
echo "  python data_stats/kfold_confusion_matrix.py \\"
echo "      --csv ${POOL_CSV} \\"
echo "      --run-prefix reach_5foldcv_v3_holdout \\"
echo "      --dumps 'dumps/v3aug_fold*' \\"
echo "      --out data_stats/kfold_confusion_matrix_v3aug.png"
