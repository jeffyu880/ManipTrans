#!/bin/bash
#SBATCH --chdir /users/jsyu/ManipTrans
#SBATCH --nodes 1
#SBATCH --cpus-per-task 8
#SBATCH --ntasks 1
#SBATCH --mem 40G
#SBATCH --gres=gpu:1
#SBATCH --qos=normal
#SBATCH --array=1-4
#SBATCH --output=logs/inspire/slurm_%j/slurm-%j.out
#SBATCH --error=logs/inspire/slurm_%j/slurm-%j.err
#SBATCH --mail-user=jeffrey.yu@epfl.ch
#SBATCH --mail-type=END,FAIL
#SBATCH --time 45:00

# Held-out validation of all five folds of the v3 NON-AUGMENTED CV family (job 77235, trained by
# ALPS_train_kfold_v3_array.run with useTrajAug=false / jointNoiseCm=0.0). Counterpart to
# ALPS_eval_kfold_detimit.run, now pointed at the v3 _AUG family; together they isolate the effect
# of TRAIN-time trajectory augmentation + 0.3 cm joint noise, so the eval arm must stay identical
# between the two scripts.
#
#   scores runs/reach_5foldcv_v3_holdout<k>_seed0__08-04-17-55-*/ on fold k's 10 held-out demos
#   -> dumps/v3_fold<k>_45_deg_err/
#
# Folds run sequentially in a SINGLE job, not a per-fold array -- see the SLURM section of
# .claude/skills/coding-rules/SKILL.md.
#
# REPURPOSED 2026-08-05. This script previously scored the 07-29 v2 SAMPLED family, which
# docs/deterministic_base_ablation.md cites as its reproduction command. To recover that run:
#     export DET_BASE=true RUN_GLOB='07-29-15-26-*'   # and drop RUN_PREFIX (defaults to v2)
#     DUMP_TAG="sampled_fold${k}" bash eval_kfold.sh "$k"
# Its results (dumps/sampled_fold{0..4}/) are untouched.
#
# The v3 pool is data_stats/reach_demo_v3.csv AS EDITED ON 2026-08-04 -- same filename as the v2
# family, different demos (m_101613/m_101752/m_101901/m_101919/m_102009 in, m_140827/m_141150/
# m_141254/m_133637/m_133727 out). v3 scores are therefore NOT comparable demo-for-demo with the
# 07-29 v2 matrices.
#
# RUN_PREFIX repoints eval_kfold.sh's checkpoint glob at the v3 family. It reaches the non-aug dirs
# only: the pattern interpolates to ..._holdout<k>_seed0__*, which does not match the _AUG dirs'
# ..._holdout<k>_seed0_AUG__* -- verified 2026-08-05. RUN_GLOB additionally pins the 08-04-17-55
# training in case a fold is ever retrained into a newer timestamped dir.
#
# Submit:  sbatch --account=abs18 slurm/alps/ALPS_eval_kfold_sampled.run
#
# --time 2:30:00: the same 5 x 10-demo sweep took 1:03:43 (job 77234) and 1:25:33 (job 77222).

echo "Starting v3 non-augmented k-fold held-out validation on $HOSTNAME at $(date)"
source /users/jsyu/miniconda3/etc/profile.d/conda.sh
conda activate maniptrans

# IsaacGym's gym_38.so links libpython3.8.so.1.0 from the conda env's lib/; `conda activate`
# does not put it on LD_LIBRARY_PATH, so the import dies without this. Derive + prepend it.
py_bin=$(command -v python) || { echo "[ERROR] python not found"; exit 1; }
py_lib="$(dirname "$(dirname "$(readlink -f "$py_bin")")")/lib"
[[ -e "$py_lib/libpython3.8.so.1.0" ]] && export LD_LIBRARY_PATH="$py_lib:${LD_LIBRARY_PATH:-}"

# The frozen imitators SAMPLE Normal(mu, sigma) at eval, as they did during v3 training. This
# differs from the v2 matrices, which were all scored at DET_BASE=true to keep the train-time
# determinism ablation clean; v3 has no such ablation to protect, so eval matches training.
export DET_BASE=false
export RUN_PREFIX='reach_5foldcv_v3_holdout'
export RUN_GLOB='08-04-17-55-*'

k=$SLURM_ARRAY_TASK_ID
TAG="v3_fold${k}_45_deg_err"

# Stagger by array index so concurrent tasks don't hit dataset load / GPU alloc together.
sleep $((SLURM_ARRAY_TASK_ID * 5))

echo "######################################################################"
echo "# FOLD ${k}  at $(date)"
echo "######################################################################"
t0=$SECONDS
# _45_deg_err records the failure threshold the env was built with: dexhandmanip_bih.py:3688
# terminates an episode past 45 deg of object-rotation error, loosened from 30. That is a
# SUCCESS-CRITERION change, so these dumps must not mix with the 30-deg dumps/v3_fold<k>/.
DUMP_TAG="$TAG" bash eval_kfold.sh "$k"
echo "=== fold ${k} finished in $((SECONDS - t0))s ==="

# Jobs 77273/77274 exited 0 having written 16 of 50 demos, because eval_kfold.sh warns and
# continues when a demo produces no dump. Without this check a partial pass is indistinguishable
# from a good one, and kfold_confusion_matrix.py silently reports the missing demos as not-run.
POOL_CSV_PATH=data_stats/reach_demo_v3.csv
# Compare the demo IDS, not just how many dumped. Counting alone passed two different failures:
# jobs 79391/79395 (pool CSV renamed -> make_kfold returned nothing, and 0 -eq 0 looked fine) and
# the 08-11 10:28 aug run, whose fold dirs held 10 dumps of demos belonging to OTHER folds --
# m_141150 is not even in the pool. Only an id-for-id match catches that.
EXPECTED_IDS=$(python data_stats/make_kfold.py --csv "$POOL_CSV_PATH" --fold "$k" \
    --which heldout --seed 0 | tr ',' '\n' | grep . | sort)
EXPECTED=$(echo "$EXPECTED_IDS" | grep -c .)
GOT_IDS=$(ls -d "dumps/${TAG}"/dump__* 2>/dev/null | sed -E 's/.*__demo_(.+)__[0-9-]+$/\1/' | sort)
GOT=$(echo "$GOT_IDS" | grep -c .)
echo "fold ${k}: ${GOT}/${EXPECTED} demos dumped -> dumps/${TAG}/"

if [[ "$EXPECTED" -eq 0 ]]; then
    echo "[ERROR] make_kfold.py returned no held-out demos for fold ${k}."
    echo "        Check that ${POOL_CSV_PATH} exists and lists demos; nothing was scored."
    exit 1
fi
if [[ "$EXPECTED_IDS" != "$GOT_IDS" ]]; then
    echo "[ERROR] fold ${k} dumps do not match its held-out set. Do not build a matrix from it."
    echo "  expected: $(echo $EXPECTED_IDS | tr '\n' ' ')"
    echo "  got     : $(echo $GOT_IDS | tr '\n' ' ')"
    echo "        Delete dumps/${TAG}/ and resubmit this array index."
    exit 1
fi

echo "======================================================================"
echo "Done at $(date). Dumps in dumps/v3_fold{0..4}_45_deg_err/."
echo "Build the matrix with:"
echo "  python data_stats/kfold_confusion_matrix.py \\"
echo "      --csv data_stats/reach_demo_v3.csv \\"
echo "      --run-prefix reach_5foldcv_v3_holdout \\"
echo "      --dumps 'dumps/v3_fold*_45_deg_err' \\"
echo "      --out data_stats/kfold_confusion_matrix_v3_45deg.png"
