#!/bin/bash
# Submitted at: $(date +%Y-%m-%d\ %H:%M:%S)
#SBATCH --chdir /users/jsyu/ManipTrans
#SBATCH --nodes 1
#SBATCH --cpus-per-task 8
#SBATCH --ntasks 1
#SBATCH --mem 40G
#SBATCH --gres=gpu:1
#SBATCH --qos=normal
#SBATCH --output=logs/inspire/slurm_%j/slurm-%j.out
#SBATCH --error=logs/inspire/slurm_%j/slurm-%j.err
#SBATCH --mail-user=jeffrey.yu@epfl.ch
#SBATCH --mail-type=END,FAIL
#SBATCH --time 24:00:00

echo "Starting ManipTrans inspire training on $HOSTNAME at $(date)"
source /users/jsyu/miniconda3/etc/profile.d/conda.sh
conda activate maniptrans

# DATA_INDICES="3b1e6@12,d6fe3@0,8e5df@13,a78a0@1,0f900@10,f7d37@18,85abe@4,e49f5@0"
# DATA_INDICES="m_161551,m_170401,m_170527,m_170654,m_170753"
DATA_INDICES="m_112645"
EXPERIMENT_NAME="capping_alcohol_burner_AUG_noise"

# Random action masking (TeleDexter Sec. C.8): 0.0 = off, which reproduces the previous baseline
# exactly; 0.15 is the paper's setting. Tagged into the experiment name so masked and baseline
# runs stay separable in W&B rather than overwriting each other's series.
ACTION_MASK_PROB=0.15
if [ "${ACTION_MASK_PROB}" != "0.0" ]; then
    EXPERIMENT_NAME="${EXPERIMENT_NAME}_actmask${ACTION_MASK_PROB}"
fi

# Consecutive subgoal co-tracking (TeleDexter Sec. 3.1): false reproduces the dense frame-wise
# baseline exactly, so flipping this is the A/B. DENSE_REWARD_SCALE is the paper's alpha_dense --
# leave it at 1.0 for the dense run, drop it to ~0.05 for the subgoal run or the dense term buries
# the sparse bonus (see config.yaml). Tagged into the experiment name so the two runs stay
# separable in W&B instead of overwriting each other's series.
SUBGOAL_TRACKING=false
DENSE_REWARD_SCALE=1.0
if [ "${SUBGOAL_TRACKING}" = "true" ]; then
    EXPERIMENT_NAME="${EXPERIMENT_NAME}_subgoal_dense${DENSE_REWARD_SCALE}"
fi

python main/rl/train.py \
    task=ResDexHand \
    dexhand=inspire \
    side=BiH \
    headless=true \
    num_envs=8192 \
    learning_rate=2e-4 \
    test=false \
    randomStateInit=true \
    "dataIndices=[${DATA_INDICES}]" \
    rh_base_model_checkpoint=assets/imitator_rh_inspire.pth \
    lh_base_model_checkpoint=assets/imitator_lh_inspire.pth \
    early_stop_epochs=1000 \
    actionsMovingAverage=0.6 \
    max_iterations=10000 \
    wandb_activate=True \
    wandb_entity=jeffreyyu880-epfl \
    wandb_project=ManipTrans \
    useCoaxialReward=false \
    useTrajAug=true \
    RH_LH_Table_Center_Aug=true \
    RH_LObj_Center_Aug=true \
    RH_RObj_Center_Aug=true \
    LH_LObj_Center_Aug=true \
    jointNoiseCm=0.5 \
    failureThresholdNoiseCompensation=1.5 \
    numTrajAug=400 \
    causal=true \
    actionMaskProb=${ACTION_MASK_PROB} \
    subgoalTracking=${SUBGOAL_TRACKING} \
    denseRewardScale=${DENSE_REWARD_SCALE} \
    "experiment='${EXPERIMENT_NAME}_${DATA_INDICES}'"



# you NEED useTrajAug in order to create augmented trajectories, if RH_LObj_Center_Aug=false, then it uses the rotation about the center of the table

# failureThresholdNoiseCompensation MULTIPLIES the failure threshold, which increases the window of varying from the joint positions from the noise 
# run with jointnoise: jointNoiseCm=0.5
# useTrajAug is backwards compatible, if only it is true, it performs TableCenterAug