#!/bin/bash
#SBATCH --chdir /users/jsyu/ManipTrans
#SBATCH --nodes 1
#SBATCH --cpus-per-task 8
#SBATCH --ntasks 1
#SBATCH --mem 40G
#SBATCH --gres=gpu:1
#SBATCH --qos=normal
#SBATCH --output=logs/inspire/slurm_%j/slurm-%j.out
#SBATCH --error=logs/inspire/slurm_%j/slurm-%j.err
#SBATCH --mail-user=jeffrey.yu@epfl.ch
#SBATCH --mail-type=END,FAIL
#SBATCH --time 6:00:00

# Stage-2 residual training on the six bc_cmplx (brush-cap complex) captures of 0803, one demo
# per array task. These have NEVER trained successfully: all 12 prior attempts failed.
#
#   77141-77156 (08-03 18:49)  Hydra: "Key 'sharedObject' is not in struct". The tree was on the
#                              final1 branch (commit f63ec9b, 17:32 that day) whose config.yaml
#                              has no sharedObject key. It exists on brush_cup at
#                              main/cfg/config.yaml:57, so the override resolves again here.
#   77183-77188 (08-04 08:19)  reaped at launch under AssocMaxJobsLimit, batch step CANCELLED
#                              after 1 s, no log dir written.
#
# Data verified present before submitting, all six indices: data/my_dataset/bc_cmplx_0803_<id>.pkl
# plus both retargets under data/retargeting/my_dataset/mano2inspire_{rh,lh}/.
#
# Flags mirror slurm/alps/ALPS_train_cup_brush_individual.run -- bc_cmplx is the same two-hands-
# on-one-brush task, so sharedObject=true applies for the same reason: both hands score the same
# body, and without it the brush's object terms are paid twice.
#
# Experiment names are bc_cmplx_<id>, NOT cup_brush_<id>. The failed attempts used the latter only
# because their scripts were copies of the cup_brush template; since no run dirs were ever
# produced there is no history to stay compatible with, and the distinct prefix keeps these out of
# the cup_brush recording sweep.
#
# Submit:  sbatch --account=abs18 --array=0-5 slurm/alps/ALPS_train_bc_cmplx_6.run
#
# --time 6:00:00: the cup_brush single-demo runs of 08-03 early-stopped in 2:13-3:11 wall; 6 h
# leaves room for the trailing record_best_checkpoint.sh pass.

echo "Starting ManipTrans bc_cmplx single-demo training on $HOSTNAME at $(date)"
source /users/jsyu/miniconda3/etc/profile.d/conda.sh
conda activate maniptrans

# IsaacGym's gym_38.so links libpython3.8.so.1.0 from the conda env's lib/; `conda activate`
# does not put it on LD_LIBRARY_PATH, so the import dies without this. Derive + prepend it.
py_bin=$(command -v python) || { echo "[ERROR] python not found"; exit 1; }
py_lib="$(dirname "$(dirname "$(readlink -f "$py_bin")")")/lib"
[[ -e "$py_lib/libpython3.8.so.1.0" ]] && export LD_LIBRARY_PATH="$py_lib:${LD_LIBRARY_PATH:-}"

CONFIGS=(
    m_101123
    m_101140
    m_101158
    m_101215
    m_101231
    m_101249
)

DATA_INDICES="${CONFIGS[$SLURM_ARRAY_TASK_ID]}"
EXPERIMENT_NAME="bc_cmplx_${DATA_INDICES}"
echo "Array task ${SLURM_ARRAY_TASK_ID} -> experiment ${EXPERIMENT_NAME}, indices ${DATA_INDICES}"

# Fail loudly here rather than 3 minutes into IsaacGym startup: these six have a history of
# launching against a tree that could not resolve their config.
if ! python -c "import sys; sys.exit(0)" 2>/dev/null; then
    echo "[ERROR] conda env not usable"; exit 1
fi

# Stagger launches by 5s per array index so concurrent tasks don't start in lockstep
# (avoids simultaneous dataset load / GPU alloc / wandb init contention).
STAGGER=$((SLURM_ARRAY_TASK_ID * 5))
echo "Sleeping ${STAGGER}s before launch (stagger by array index)"
sleep ${STAGGER}

python main/rl/train.py \
    task=ResDexHand \
    dexhand=inspire \
    side=BiH \
    headless=true \
    num_envs=8192 \
    learning_rate=2e-4 \
    test=false \
    randomStateInit=true \
    "dataIndices=[${DATA_INDICES}]" \
    rh_base_model_checkpoint=assets/imitator_rh_inspire.pth \
    lh_base_model_checkpoint=assets/imitator_lh_inspire.pth \
    early_stop_epochs=1000 \
    actionsMovingAverage=0.6 \
    max_iterations=10000 \
    wandb_activate=True \
    wandb_entity=jeffreyyu880-epfl \
    wandb_project=ManipTrans \
    sharedObject=true \
    useCoaxialReward=false \
    useTrajAug=false \
    RH_LH_Table_Center_Aug=true \
    RH_LObj_Center_Aug=false \
    RH_RObj_Center_Aug=false \
    LH_LObj_Center_Aug=false \
    causal=true \
    jointNoiseCm=0.0 \
    failureThresholdNoiseCompensation=1.5 \
    numTrajAug=100 \
    "experiment='${EXPERIMENT_NAME}'"

# NO video recording on ALPS. capture_video=true dies in IsaacGym's camera path here --
#   [Error] [carb.gym.plugin] cudaImportExternalMemory failed on rgbImage buffer with error 999
#   Segmentation fault (core dumped)
# (observed in job 77204, 2026-08-04). Record on SCITAS instead:
#   sbatch slurm/scitas/record_best_checkpoint.run
