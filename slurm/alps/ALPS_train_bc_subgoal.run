#!/bin/bash
# Submitted at: $(date +%Y-%m-%d\ %H:%M:%S)
#SBATCH --chdir /users/jsyu/ManipTrans
#SBATCH --nodes 1
#SBATCH --cpus-per-task 8
#SBATCH --ntasks 1
#SBATCH --mem 40G
#SBATCH --gres=gpu:1
#SBATCH --qos=normal
#SBATCH --output=logs/inspire/slurm_%j/slurm-%j.out
#SBATCH --error=logs/inspire/slurm_%j/slurm-%j.err
#SBATCH --mail-user=jeffrey.yu@epfl.ch
#SBATCH --mail-type=END,FAIL
#SBATCH --time 12:00:00

# Stage-2 residual training on the cup+brush pool with CONSECUTIVE SUBGOAL CO-TRACKING
# (subgoalTracking=true, TeleDexter Sec. 3.1) and NO augmentation. ONE residual over all 36 demos,
# NOT one per demo -- unlike every existing b_c script (ALPS_train_cup_brush_individual.run,
# ALPS_train_bc5_individual.run, ALPS_train_bc_cmplx_6.run), which train a separate policy per
# capture. A single pooled policy is required here: cross-trajectory switching (Eq. 9) draws its
# next subgoal from ANOTHER demo of the same object, so with one demo in dataIndices there is
# nothing to switch to and build_cross_traj_pool silently turns it off.
#   -> runs/bc_subgoal_pool36__<date>/
#
# THE POOL (36 demos, three captures; verified raw pkl + both retargets present on 2026-09-01)
#   b_c_0819    (4 of 15)  m_122814 m_122832 m_122850 m_122909
#   b_c_4_0822  (11, all)  m_142506 m_144612 m_144630 m_144709 m_144729 m_144748
#                          m_144812 m_144831 m_144852 m_144914 m_144933
#   b_c_5_0822  (21, all)  m_151753 ... m_152423
#
# sharedObject=true is REQUIRED and is purely a REWARD toggle: both hands score the same body (the
# brush), so without it the brush's object terms are paid twice -- once per hand -- doubling their
# weight against the hand-tracking terms. Spawning one scored actor instead of two is inferred from
# the demo itself, not from this flag. It also matters for the SUBGOAL score specifically:
# subgoal_reach_state weights the object half by _obj_reward_share, whose two halves sum to 1 under
# sharedObject, so r_score pays the object once in total across the summed hands -- matching the
# dense term. Without the flag the subgoal bonus would double-count the brush the same way.
#
# objectSet is deliberately NOT passed: it is a LIVE-only knob. Offline the loaders infer the set
# from the objects the capture recorded. Same as ALPS_train_bc5_individual.run.
#
# NO augmentation, so subgoal tracking is the only treatment against the existing b_c baselines:
# useTrajAug=false, all four *_Center_Aug=false, numTrajAug=1, jointNoiseCm=0.0. Note the existing
# b_c scripts pass RH_LH_Table_Center_Aug=true and numTrajAug=100 but ALSO useTrajAug=false, which
# makes both inert; setting them false here states the same thing without the misdirection.
# failureThresholdNoiseCompensation=1.0 (config default): there is no injected noise, and under
# subgoalTracking the finger failure ladder it scales is not evaluated at all.
#
# SUBGOAL PARAMETERS come from main/cfg/config.yaml (tuned for this repo -- see the comments there
# for the arithmetic); only the two that cannot be defaulted are passed:
#   subgoalCrossTrajProb 0.1 -- the paper's Eq. 9 value. Config default is 0.0 (off). Scope stays
#       `aug`: same augmentation variant, different base demo, which with useTrajAug=false means
#       one variant and all 36 demos as candidates (35 per env).
#       CAVEAT specific to this pool: the 36 come from THREE separate capture sessions, so a switch
#       can land on a demo recorded in a different table layout. The reach pool has the same
#       property and trains fine, but if the subgoal hit rate stalls, scope/pool composition is the
#       first thing to look at -- not eta_fail.
#   denseRewardScale 0.02 -- alpha_dense. 1.0 must stay the exact no-op default while subgoal
#       tracking is off, so it is set here.
#
# No chained held-out eval, unlike ALPS_train_kfold_v2_subgoal_array.run: there is no fold split
# defined for the b_c pool (data_stats/ has no b_c CSV), so there is nothing to score against that
# the policy did not train on. Score with record_best_checkpoint.sh on SCITAS, or ask for a fold
# CSV if a held-out number is wanted.
#
# Submit:  sbatch --account=abs18 slurm/alps/ALPS_train_bc_subgoal.run
#
# --time 12:00:00: matches ALPS_train_kfold_v2_subgoal_array.run, which pools a comparable 40
# demos under the same subgoal settings. Longer than the 8 h the single-demo b_c runs used
# (they early-stopped in 2:13-3:11) because subgoal episodes run to a 1200-step cap and the
# per-finger instant-fail ladder is off, so early termination is far rarer.

echo "Starting cup+brush SUBGOAL pooled training on $HOSTNAME at $(date)"
source /users/jsyu/miniconda3/etc/profile.d/conda.sh
conda activate maniptrans

# IsaacGym's gym_38.so links libpython3.8.so.1.0 from the conda env's lib/; `conda activate` does
# not put it on LD_LIBRARY_PATH, so the import dies without this. Derive + prepend it.
py_bin=$(command -v python) || { echo "[ERROR] python not found"; exit 1; }
py_lib="$(dirname "$(dirname "$(readlink -f "$py_bin")")")/lib"
[[ -e "$py_lib/libpython3.8.so.1.0" ]] && export LD_LIBRARY_PATH="$py_lib:${LD_LIBRARY_PATH:-}"

# One flat comma-separated list; grouped by capture for readability only.
DEMOS=(
    # b_c_0819 (4 of 15)
    m_122814 m_122832 m_122850 m_122909
    # b_c_4_0822 (11, all)
    m_142506 m_144612 m_144630 m_144709 m_144729 m_144748
    m_144812 m_144831 m_144852 m_144914 m_144933
    # b_c_5_0822 (21, all)
    m_151753 m_151811 m_151829 m_151848 m_151911 m_151930 m_151949
    m_152006 m_152026 m_152045 m_152103 m_152123 m_152144 m_152203
    m_152221 m_152240 m_152259 m_152320 m_152339 m_152402 m_152423
)
DATA_INDICES=$(IFS=,; echo "${DEMOS[*]}")
EXPERIMENT_NAME="bc_subgoal_pool36"

echo "experiment ${EXPERIMENT_NAME}"
echo "  ${#DEMOS[@]} demos: ${DATA_INDICES}"

# Cross-trajectory switching needs something to switch to, and a missing retarget is a silent
# per-demo drop rather than an error. Check the whole pool up front instead of losing candidates.
MISSING=""
for d in "${DEMOS[@]}"; do
    for side in rh lh; do
        compgen -G "data/retargeting/my_dataset/mano2inspire_${side}/*${d}*" > /dev/null \
            || MISSING+="${d}:${side} "
    done
done
if [[ -n "$MISSING" ]]; then
    echo "[ERROR] missing retargets: ${MISSING}"
    echo "        Retarget them first (main/dataset/mano2dexhand.py, both sides) and resubmit."
    exit 1
fi

python main/rl/train.py \
    task=ResDexHand \
    dexhand=inspire \
    side=BiH \
    headless=true \
    num_envs=8192 \
    learning_rate=2e-4 \
    test=false \
    randomStateInit=true \
    "dataIndices=[${DATA_INDICES}]" \
    rh_base_model_checkpoint=assets/imitator_rh_inspire.pth \
    lh_base_model_checkpoint=assets/imitator_lh_inspire.pth \
    early_stop_epochs=1000 \
    actionsMovingAverage=0.6 \
    max_iterations=10000 \
    wandb_activate=True \
    wandb_entity=jeffreyyu880-epfl \
    wandb_project=ManipTrans \
    sharedObject=true \
    useCoaxialReward=false \
    useTrajAug=false \
    RH_LH_Table_Center_Aug=false \
    RH_LObj_Center_Aug=false \
    RH_RObj_Center_Aug=false \
    LH_LObj_Center_Aug=false \
    numTrajAug=1 \
    causal=true \
    jointNoiseCm=0.0 \
    deterministicBaseAction=false \
    failureThresholdNoiseCompensation=1.0 \
    subgoalTracking=true \
    subgoalCrossTrajProb=0.1 \
    denseRewardScale=0.02 \
    "experiment='${EXPERIMENT_NAME}'"

echo "Finished at $(date)"
