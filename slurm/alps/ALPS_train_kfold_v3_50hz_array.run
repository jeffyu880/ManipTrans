#!/bin/bash
#SBATCH --chdir /users/jsyu/ManipTrans
#SBATCH --nodes 1
#SBATCH --cpus-per-task 8
#SBATCH --ntasks 1
#SBATCH --mem 40G
#SBATCH --gres=gpu:1
#SBATCH --qos=normal
#SBATCH --array=0-4
#SBATCH --output=logs/inspire/slurm_%j/slurm-%j.out
#SBATCH --error=logs/inspire/slurm_%j/slurm-%j.err
#SBATCH --mail-user=jeffrey.yu@epfl.ch
#SBATCH --mail-type=END,FAIL
#SBATCH --time 6:00:00

# 5-fold CV over the v3 reach pool, NON-AUGMENTED, at demoTargetFps=50.
#   task k -> runs/reach_5foldcv_v3_holdout<k>_seed0_50hz__<date>/ + dumps/v350hz_fold<k>/
#
# One variable versus the existing non-augmented 60 Hz family (job 77235,
# runs/reach_5foldcv_v3_holdout<k>_seed0__08-04-17-55-*): demoTargetFps. Every other flag below is
# copied from that run, so the two are directly comparable.
#
# WHAT demoTargetFps=50 ACTUALLY DOES -- it does NOT subsample. my_dataset is 60 Hz native
# (my_dataset_RH.py:50; the retargeted pkls carry retarget_fps=60.0), and base.py:42 derives
# skip = max(1, round(fps/target_fps)) = round(60/50) = 1, so every source frame is kept. What
# changes is the timestep: ResDexHand.yaml:158-159 resolve to dt = 1/50 s and
# substeps = round(120/50) = 2. So the same trajectory is executed 20% SLOWER, with a 1/100 s
# physics sub-step instead of the 1/120 s the config comment intends to hold. episodeLength scales
# with the rate (fps_scale60: 1200 -> 1000). Verified by composing the resolvers directly:
#     demoTargetFps=None -> dt=0.01667 substeps=2 episodeLength=1200
#     demoTargetFps=50   -> dt=0.02000 substeps=2 episodeLength=1000
# Use demoTargetFps=30 if genuine subsampling is wanted (skip=2, true 30 Hz); 50 is a
# rounding-unlucky target for a 60 Hz source.
#
# POOL: data_stats/reach_demo_v3.csv. Not reach_demo_v2.csv -- that file still exists and still
# lists m_140827/m_141150/m_141254/m_133637/m_133727, and deals a different split.
#
# PREREQS: retargeted pkls for every pool demo (data/retargeting/my_dataset/mano2inspire_{rh,lh}/).
#
# Submit:  sbatch --account=abs18 slurm/alps/ALPS_train_kfold_v3_50hz_array.run
# Add %N to --array (e.g. 0-4%2) to cap concurrency if GPUs are scarce.
#
# --time 6:00:00: the 60 Hz folds trained in 2:45:33-4:00:44 (all early-stopped). At dt=1/50 an
# episode is 1000 steps rather than 1200, so this should be no slower; 6 h keeps the same margin.

echo "Starting v3 non-augmented 50Hz 5-fold CV training on $HOSTNAME at $(date)"
source /users/jsyu/miniconda3/etc/profile.d/conda.sh
conda activate maniptrans

POOL_CSV="data_stats/reach_demo_v3.csv"
K=$SLURM_ARRAY_TASK_ID
DATA_INDICES=$(python data_stats/make_kfold.py --csv "$POOL_CSV" --fold "$K" --which train --seed 0)
HELDOUT=$(python data_stats/make_kfold.py --csv "$POOL_CSV" --fold "$K" --which heldout --seed 0)
EXPERIMENT_NAME="reach_5foldcv_v3_holdout${K}_seed0_50hz"

echo "Array task ${K} -> experiment ${EXPERIMENT_NAME}"
echo "  held-out fold ${K} (validation, NOT trained): ${HELDOUT}"
echo "  training on: ${DATA_INDICES}"

# The scored fold must share no demo with the 40 just trained on. make_kfold.py deals both lists
# from one split, so this can only fire if $POOL_CSV changed between the two calls above.
if [[ -z "$DATA_INDICES" || -z "$HELDOUT" ]]; then
    echo "[ERROR] make_kfold.py returned nothing -- does ${POOL_CSV} exist and list demos?"
    exit 1
fi
OVERLAP=""
for demo in ${HELDOUT//,/ }; do
    [[ ",${DATA_INDICES}," == *",${demo},"* ]] && OVERLAP+="${demo} "
done
if [[ -n "$OVERLAP" ]]; then
    echo "[ERROR] held-out demos also appear in the training set: ${OVERLAP}"
    echo "        ${POOL_CSV} must have changed between the two make_kfold.py calls above."
    exit 1
fi

# Stagger by array index so concurrent tasks don't contend on dataset load / GPU alloc / wandb init.
STAGGER=$((SLURM_ARRAY_TASK_ID * 5))
echo "Sleeping ${STAGGER}s before launch (stagger by array index)"
sleep ${STAGGER}

python main/rl/train.py \
    task=ResDexHand \
    dexhand=inspire \
    side=BiH \
    headless=true \
    num_envs=8192 \
    learning_rate=2e-4 \
    test=false \
    randomStateInit=true \
    "dataIndices=[${DATA_INDICES}]" \
    rh_base_model_checkpoint=assets/imitator_rh_inspire.pth \
    lh_base_model_checkpoint=assets/imitator_lh_inspire.pth \
    early_stop_epochs=1000 \
    actionsMovingAverage=0.6 \
    max_iterations=10000 \
    wandb_activate=True \
    wandb_entity=jeffreyyu880-epfl \
    wandb_project=ManipTrans \
    useCoaxialReward=false \
    useTrajAug=false \
    RH_LH_Table_Center_Aug=true \
    RH_LObj_Center_Aug=true \
    RH_RObj_Center_Aug=true \
    LH_LObj_Center_Aug=true \
    causal=true \
    jointNoiseCm=0.0 \
    deterministicBaseAction=false \
    failureThresholdNoiseCompensation=1.5 \
    numTrajAug=10 \
    demoTargetFps=50 \
    "experiment='${EXPERIMENT_NAME}'"

# ---------------------------------------------------------------------------
# Held-out validation of the residual just trained, on fold K's clean demos.
#
# demoTargetFps is NOT passed to eval_kfold.sh: its COMMON block leaves demoTargetFps at the
# config default (null = 60 Hz), so a 50 Hz-trained policy would be scored at 60 Hz. Whether that
# is the comparison you want is a real question -- scoring at the training rate measures the policy,
# scoring at 60 Hz measures whether 50 Hz training transfers back. This runs the 60 Hz arm, matching
# how every other v3 family was scored. Add POOL_CSV/demoTargetFps overrides here to change it.
# ---------------------------------------------------------------------------
echo "######################################################################"
echo "# FOLD ${K} held-out validation at $(date)"
echo "######################################################################"

# IsaacGym's gym_38.so links libpython3.8.so.1.0 from the conda env's lib/; `conda activate` does
# not put it on LD_LIBRARY_PATH. Same block as ALPS_eval_kfold_sampled.run.
py_bin=$(command -v python) || { echo "[ERROR] python not found"; exit 1; }
py_lib="$(dirname "$(dirname "$(readlink -f "$py_bin")")")/lib"
[[ -e "$py_lib/libpython3.8.so.1.0" ]] && export LD_LIBRARY_PATH="$py_lib:${LD_LIBRARY_PATH:-}"

# eval_kfold.sh interpolates runs/<prefix><k>_seed0__<glob>, so no RUN_PREFIX reaches this family --
# the _50hz suffix sits between _seed0 and __. Resolve the checkpoint here and pass --checkpoint,
# the same way ALPS_eval_kfold_detimit.run does.
RUN_DIR=$(ls -td runs/${EXPERIMENT_NAME}__* 2>/dev/null | head -1)
if [[ -z "$RUN_DIR" ]]; then
    echo "[ERROR] no run dir matched runs/${EXPERIMENT_NAME}__* -- training produced nothing to score."
    exit 1
fi

# Highest-reward checkpoint. `_rew_+` absorbs the doubled underscore base.py writes for early-stop
# saves, which a plain (?<=_rew_) lookbehind silently skips; \K keeps only the number.
BEST=""
BEST_REW=-9999999
shopt -s nullglob
for pth in "${RUN_DIR}"/nn/*.pth; do
    rew=$(basename "$pth" | grep -oP '_rew_+\K-?[0-9.]+' | head -1)
    [[ -z "$rew" ]] && continue
    if awk "BEGIN{exit !($rew > $BEST_REW)}"; then BEST_REW="$rew"; BEST="$pth"; fi
done
shopt -u nullglob
if [[ -z "$BEST" ]]; then
    echo "[ERROR] no reward-parseable checkpoint under ${RUN_DIR}/nn/ -- nothing to score."
    exit 1
fi
echo "  best checkpoint (rew ${BEST_REW}): ${BEST}"

TAG="v350hz_fold${K}"
t0=$SECONDS
DET_BASE=false DUMP_TAG="$TAG" bash eval_kfold.sh --checkpoint "$BEST" "$K"
echo "=== fold ${K} eval finished in $((SECONDS - t0))s -> dumps/${TAG}/ ==="

# Compare demo IDS, not just how many dumped. Counting alone passed two separate failures before:
# a renamed pool CSV (make_kfold returned nothing, and 0 -eq 0 looked fine) and fold dirs holding
# 10 dumps of demos belonging to OTHER folds. Only an id-for-id match catches those.
EXPECTED_IDS=$(python data_stats/make_kfold.py --csv "$POOL_CSV" --fold "$K" \
    --which heldout --seed 0 | tr ',' '\n' | grep . | sort)
EXPECTED=$(echo "$EXPECTED_IDS" | grep -c .)
GOT_IDS=$(ls -d "dumps/${TAG}"/dump__* 2>/dev/null | sed -E 's/.*__demo_(.+)__[0-9-]+$/\1/' | sort)
GOT=$(echo "$GOT_IDS" | grep -c .)
echo "fold ${K}: ${GOT}/${EXPECTED} demos dumped -> dumps/${TAG}/"
if [[ "$EXPECTED" -eq 0 ]]; then
    echo "[ERROR] make_kfold.py returned no held-out demos for fold ${K}; nothing was scored."
    exit 1
fi
if [[ "$EXPECTED_IDS" != "$GOT_IDS" ]]; then
    echo "[ERROR] fold ${K} dumps do not match its held-out set. Do not build a matrix from it."
    echo "  expected: $(echo $EXPECTED_IDS | tr '\n' ' ')"
    echo "  got     : $(echo $GOT_IDS | tr '\n' ' ')"
    exit 1
fi

echo "Once all five tasks are done, build the matrix with:"
echo "  python data_stats/kfold_confusion_matrix.py \\"
echo "      --csv ${POOL_CSV} \\"
echo "      --run-prefix reach_5foldcv_v3_holdout \\"
echo "      --dumps 'dumps/v350hz_fold*' \\"
echo "      --out data_stats/kfold_confusion_matrix_v3_50hz.png"
