<?xml version="1.0"?>
<!-- 3D-printed square brush captured with the OptiTrack+AVP rig (Motive rigid body "d2_brush").
     The mesh is the COACD convex decomposition (2 submeshes); the env loads it with
     convex_decomposition_from_submeshes enabled, so each submesh becomes its own convex collision
     shape. Mass comes from asset_options.density (200 kg/m^3, low-fill 3D print) — the same value
     every OakInk-v2 object is loaded with. -->
<robot name="square_brush">
  <material name="obj_color">
      <color rgba="1.0 0.423529411765 0.0392156862745 1.0"/>
  </material>
  <link name="base">
    <visual>
      <origin xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="square_brush.obj" scale="1 1 1"/>
      </geometry>
      <material name="obj_color"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="square_brush.obj" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
</robot>
